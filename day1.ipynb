   "source": [
    "# 199 : BINARY TREE RIGHT SIDE VIEW\nGiven the root of a binary tree, imagine yourself standing on the right side of it, return the values of the nodes you can see ordered from top to bottom.\nDifficulty: Medium\n",
    "# My Approach: I used to the Breadth-First Search (Level Order) approach, as last node in each level is the first node we view when looking from the right side.\n",
    "\n",
    "def rightSideView(self, root: Optional[TreeNode]) -> List[int]:\n",
    "        if not root:\n",
    "            return []\n",
    "        \n",
    "        q = deque([root])\n",
    "        right_nodes = []\n",
    "\n",
    "        while q:\n",
    "            level_size = len(q)\n",
    "            for i in range(level_size):\n",
    "                node = q.popleft()\n",
    "                if i == level_size-1:\n",
    "                    right_nodes.append(node.val)\n",
    "                if node.left:\n",
    "                    q.append(node.left)\n",
    "                if node.right:\n",
    "                    q.append(node.right)\n",
    "        return right_nodes\n",
   ]
  }
